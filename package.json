{
	"name": "ran-starter-plugin",
	"version": "0.1.0",
	"description": "A modern WordPress plugin starter.",
	"author": "Benjamin Rush",
	"license": "MIT",
	"homepage": "https://github.com/RocketsAreNostalgic",
	"type": "module",
	"config": {
		"dist": "assets/dist",
		"src_public": "assets/src/public",
		"src_admin": "assets/src/admin",
		"dist_public": "assets/dist/public",
		"dist_admin": "assets/dist/admin"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/RocketsAreNostalgic/ran-starter-plugin.git"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint:js": "eslint 'assets/src/admin/js/**/*.{js,mjs,ts,mts}' 'assets/src/public/js/**/*.{js,mjs,ts,mts}'",
		"lint:css": "stylelint 'assets/src/admin/styles/**/*.{css,scss}' 'assets/src/public/styles/**/*.{css,scss}'",
		"lint": "eslint 'assets/src/admin/js/**/*.{js,mjs,ts,mts}' 'assets/src/public/js/**/*.{js,mjs,ts,mts}' && stylelint 'assets/src/admin/styles/**/*.{css,scss}' 'assets/src/public/styles/**/*.{css,scss}'",
		"format": "prettier --write 'assets/**/*.{js,scss,css}'",
		"format:check": "prettier --check 'assets/**/*.{js,scss,css}'",
		"release:archive": "php scripts/build-release.php",
		"release:archive:check": "php scripts/build-release.php --check",
		"check": "eslint 'assets/src/admin/js/**/*.{js,mjs,ts,mts}' 'assets/src/public/js/**/*.{js,mjs,ts,mts}' && stylelint 'assets/src/admin/styles/**/*.{css,scss}' 'assets/src/public/styles/**/*.{css,scss}' && prettier --check 'assets/**/*.{js,scss,css}' && pnpm check:generated",
		"check:generated": "vite build && git diff --exit-code -- assets/dist",
		"test:php": "composer test"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.51.0",
		"@wordpress/eslint-plugin": "^25.7.0",
		"@wordpress/prettier-config": "^4.51.0",
		"@wordpress/stylelint-config": "^24.0.0",
		"browserslist": "^4.28.6",
		"eslint": "^9.39.5",
		"prettier": "^3.9.5",
		"sass": "^1.101.0",
		"stylelint": "^16.26.1",
		"stylelint-config-rational-order": "^0.1.2",
		"stylelint-high-performance-animation": "^1.11.0",
		"stylelint-no-unsupported-browser-features": "^8.1.1",
		"stylelint-scss": "^6.14.0",
		"stylelint-use-logical-spec": "^5.0.1",
		"vite": "^7.3.6"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": ">=24.11.0 <25",
		"pnpm": ">=11"
	},
	"volta": {
		"node": "24.11.0"
	},
	"packageManager": "pnpm@11.13.1",
	"prettier": "@wordpress/prettier-config"
}
